{
  "schema": "portable_trace_pipeline_v1",
  "repo_root": "/absolute/path/to/target_project",
  "python": ".venv/bin/python",
  "protocol": "/absolute/path/to/trace_core/protocol.json",
  "selection": {
    "backend": "rule",
    "scorer_checkpoint": null
  },
  "output_root": "/absolute/path/to/trace_run",
  "refresh_cycle": 1,
  "seed": 42,
  "simulator": {
    "task": "NORMAL_SIMULATOR_TASK_NAME",
    "device": "cuda:0",
    "gpu_pool": "0",
    "gpu_wrapper": "adapters/run_simulator_stage.sh",
    "environments_per_batch": 1024,
    "source_selection_seed": 10421,
    "rollout_seed_base": 20430,
    "rollout_actor_arguments": [
      "--policy_checkpoint",
      "{rollout_actor_checkpoint}"
    ],
    "extra_arguments": [
      "--dataset_obs_kind",
      "proprioceptive",
      "--action_noise_std",
      "0.0",
      "--medium_action_noise_std",
      "0.0",
      "--failure_action_noise_std",
      "0.0",
      "--no-use_domain_randomization",
      "--no-use_push_randomization",
      "--no-use_observation_noise",
      "--payload_mass_range_kg",
      "0.0",
      "0.0",
      "--rr_calf_strength_range",
      "0.5",
      "0.5",
      "--env_action_delay_steps",
      "0",
      "0",
      "--env_action_noise_std",
      "0.0",
      "--command_modes",
      "stand,pure_x,pure_y,pure_yaw,xy,x_yaw,y_yaw,xy_yaw"
    ]
  },
  "tools": {
    "source_selector": "adapters/select_source_starts.py",
    "candidate_collector": "adapters/collect_simulator_candidates.py",
    "candidate_merger": "adapters/merge_candidate_branches.py",
    "candidate_auditor": "adapters/audit_candidate_set.py",
    "summary_replay_builder": "adapters/build_summary_or_replay.py",
    "distribution_selector": "adapters/select_by_command_distribution.py",
    "replay_manifest": "adapters/replay_manifest.py"
  }
}
